# Auth
SECRET=change-me-long-random-string
ADMIN_PASSWORD=change-me

# PostgreSQL. Railway can inject DATABASE_URL from the Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/db
DATABASE_SSL=true

# LLM providers. The admin panel chooses provider/model per run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# STT
ASSEMBLYAI_API_KEY=

# S3-compatible object storage, path-style signing.
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=interview-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Next/Railway
NODE_ENV=production
